<section class="home-hero">
  <div class="home-hero-inner">

    <div class="home-copy">

      <div class="home-kicker">
        Oxford University Association Croquet Club
      </div>

      <h1>
        Association croquet in Oxford since 1867
      </h1>

      <p>
        Play on the University Parks courts, learn from experienced players, compete for Oxford and take part in one of the University’s oldest sporting traditions.
      </p>

      <div class="home-actions">
        <a class="button button-solid light" href="oucc/join.html">
          Join the Club
        </a>

        <a
          class="button button-outline light"
          href="mailto:interested-2026-ouacc-subscribe@maillist.ox.ac.uk?subject=subscribe"
        >
          Join the mailing list
        </a>
      </div>

    </div>

    <div
      aria-label="Croquet on the OUACC courts in the University Parks"
      class="home-photo"
      role="img"
    >
    </div>

  </div>
</section>


