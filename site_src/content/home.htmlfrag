<section class="editorial">

  <div class="section-label">
    The Club
  </div>

  <h2>
    Serious about croquet, open to everyone
  </h2>

  <p class="lead">
    OUACC brings together complete beginners, regular players and experienced competitors. Members have access to full-size courts, Club equipment, coaching and a programme of matches and competitions.
  </p>

  <div class="three-grid">

    <article class="news-card">

      <a
        class="card-link-overlay"
        href="college/cuppersintro.html"
        aria-label="Explore Cuppers"
      >
        <span class="visually-hidden">
          Explore Cuppers
        </span>
      </a>

      <div class="news-card-media">
        <img
          alt="Winners of Croquet Cuppers 2026."
          loading="lazy"
          src="images/editorial/winners_cuppers_2026.jpg"
        />
      </div>

      <div class="section-label">
        College competition
      </div>

      <h3>
        Croquet Cuppers
      </h3>

      <p>
        OUACC runs Oxford’s inter-college croquet competition, bringing teams together from across the University.
      </p>

      <div class="card-link">
        Explore Cuppers
      </div>

    </article>


    <article class="news-card">

      <a
        class="card-link-overlay"
        href="varsity/index.html"
        aria-label="Explore Varsity"
      >
        <span class="visually-hidden">
          Explore Varsity
        </span>
      </a>

      <div class="news-card-media">
        <img
          alt="Oxford Varsity team, 1983."
          loading="lazy"
          src="images/editorial/varsity_1983.jpg"
        />
      </div>

      <div class="section-label">
        Oxford v Cambridge
      </div>

      <h3>
        Varsity
      </h3>

      <p>
        Each year the Club fields an Oxford team for the Varsity Match against Cambridge at the Hurlingham Club.
      </p>

      <div class="card-link">
        Explore Varsity
      </div>

    </article>


    <article class="news-card">

      <a
        class="card-link-overlay"
        href="coaching/howtoplay.html"
        aria-label="Learn the game"
      >
        <span class="visually-hidden">
          Learn the game
        </span>
      </a>

      <div class="news-card-media">
        <img
          alt="Coaching on the University Parks courts."
          loading="lazy"
          src="images/editorial/coaching.jpg"
        />
      </div>

      <div class="section-label">
        Club life
      </div>

      <h3>
        Play and improve
      </h3>

      <p>
        Start with introductory coaching, join Club evenings, enter competitions and progress at your own pace.
      </p>

      <div class="card-link">
        Learn the game
      </div>

    </article>

  </div>

</section>


<section class="feature-band">

  <div class="feature-inner">

    <div class="feature-copy">

      <div class="section-label light">
        University Parks
      </div>

      <h2>
        Two full-size courts in the centre of Oxford
      </h2>

      <p>
        The Club’s courts are in the University Parks. Members can book courts, use Club equipment and play throughout the season, subject to fixtures and coaching.
      </p>

      <div class="feature-actions">

        <a
          class="button button-solid light"
          href="https://croquetbooking.com/book/index.php?view=day&amp;area=1&amp;room=1&amp;site=53"
        >
          Book a court
        </a>

        <a
          class="button button-outline light"
          href="oucc/directions.html"
        >
          Find us
        </a>

      </div>

    </div>

    <div class="feature-photo">

      <img
        alt="Association croquet in play on the University Parks courts"
        src="images/editorial/playing_all_balls.jpg"
        loading="lazy"
      />

    </div>

  </div>

</section>


